      }
    },
    "Your assistant uses it with your own key, kept in its memory. A tool the service marks read-only runs as asked; any other asks you first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your assistant uses it with your own key, kept in its memory. A tool the service marks read-only runs as asked; any other asks you first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu asistente lo usa con tu propia clave, guardada en su memoria. Una herramienta que el servicio marca como de solo lectura se ejecuta cuando se lo pides; las demás te preguntan antes."
          }
        }
      }
    },
    "Your assistant, its memory and its automations come back and run on this Mac. It's offline for about a minute." : {
