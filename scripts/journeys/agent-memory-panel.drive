// Open and close a memory beside the agent chat, scrolled up: the row you
// were reading does not move (rule 7: the panel slides, the column changes
// width once; rule 2: a resize holds the reading row).
// check: memory hold=agent
{"width": 1180}
{"agent": "seed", "turns": 14}
{"select": "Peel"}
{"wait": 1.5}
{"scroll": 500, "in": "agent"}
{"wait": 1}
{"probe": "memory", "for": 3.5}
{"agent": "memory"}
{"wait": 1.2}
{"agent": "memory-close"}
{"wait": 1.5}
