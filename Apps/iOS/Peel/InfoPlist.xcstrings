{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel uses the camera when you turn on video in a call, to scan an invoice, or to take a photo or record a video to send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel usa la cámara cuando activas el video en una llamada, para escanear una factura o para tomar una foto o grabar un video y enviarlo."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel uses Face ID to unlock in place of your PIN, when you turn it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel usa Face ID para desbloquear en lugar de tu PIN, cuando lo activas."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel shares your location with a website you open in Peel, only when that site asks and you allow it. Peel doesn't keep or send it anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel comparte tu ubicación con un sitio web que abres en Peel, solo cuando ese sitio la pide y tú lo permites. Peel no la guarda ni la envía a ningún lado."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel uses the microphone so people on a call can hear you, to record voice messages you hold the microphone button for, to record video with sound to send, and so you can talk to the Peel agent in voice mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel usa el micrófono para que las personas en una llamada te escuchen, para grabar los mensajes de voz que haces al mantener presionado el botón del micrófono, para grabar video con sonido y enviarlo, y para que puedas hablar con el agente de Peel en modo de voz."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel recognises your speech on this iPhone, so you can talk to the Peel agent in voice mode. Recognition is on this iPhone where the system supports it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel reconoce tu voz en este iPhone, para que puedas hablar con el agente de Peel en modo de voz. El reconocimiento se hace en este iPhone cuando el sistema lo admite."
          }
        }
      }
    },
    "PagePrecise" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The site you allowed asked for your precise location for this visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sitio que permitiste pidió tu ubicación precisa para esta visita."
          }
        }
      }
    }
  },
  "version" : "1.0"
}