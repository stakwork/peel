// needs: peer
// The tribe left at its bottom, then the direct chat while the peer posts
// in the tribe, back once the post has come (the tribe unread); back to
// the tribe: at "New messages", its newest, the new message in view.
// check: back land=end pill=none
{"width": 1180}
{"select": "{{tribe}}"}
{"wait": 2.5}
{"probe": "back", "for": 30}
{"select": "{{chat}}"}
{"signal": "peer-posts-tribe"}
{"unread": "{{tribe}}"}
{"select": "{{tribe}}"}
{"wait": 2.5}
