// needs: peer
// The tribe scrolled up, then the direct chat while the peer posts in the
// tribe; back to the tribe: on the row you were reading, not the newest
// (the pill counts the new message; not judged here).
// check: back land=anchor
{"width": 1180}
{"select": "{{tribe}}"}
{"wait": 2}
{"scroll": 1500}
{"wait": 1}
{"probe": "back", "for": 8}
{"select": "{{chat}}"}
{"signal": "peer-posts-tribe"}
{"wait": 4}
{"select": "{{tribe}}"}
{"wait": 2.5}
