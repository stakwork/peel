    "Removes the account and its messages from this Mac. You need your twelve words to sign back in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the account and its messages from this Mac. You need your twelve words to sign back in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la cuenta y sus mensajes de este Mac. Necesitas tus doce palabras para volver a iniciar sesión."
          }
        }
      }
    },
    "Removes the account and its messages from this Mac. Your assistant still runs on your home server: turn off Always on first, or wipe that box, before you sign in with your twelve words anywhere." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the account and its messages from this Mac. Your assistant still runs on your home server: turn off Always on first, or wipe that box, before you sign in with your twelve words anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
