          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu asistente conocerá estos espacios de trabajo desde su próxima conversación nueva."
          }
        }
      }
    },
    "Your assistant moved to your home server. Reply so Peel knows you're there." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your assistant moved to your home server. Reply so Peel knows you're there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu asistente se mudó a tu servidor doméstico. Responde para que Peel sepa que estás allí."
          }
        }
      }
    },
    "Your assistant only answers while this Mac is awake. Run it on a home server to keep it answering around the clock." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your assistant only answers while this Mac is awake. Run it on a home server to keep it answering around the clock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu asistente solo responde mientras este Mac está activo. Ejecútalo en un servidor doméstico para que responda las 24 horas."
          }
        }
      }
    },
    "Your assistant runs on your home server, with the services it had. Turn off Always on to change them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your assistant runs on your home server, with the services it had. Turn off Always on to change them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu asistente se ejecuta en tu servidor de casa, con los servicios que tenía. Desactiva «Siempre activo» para cambiarlos."
          }
        }
      }
    },
    "Your assistant runs on your home server. Message it in Direct messages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your assistant runs on your home server. Message it in Direct messages."
