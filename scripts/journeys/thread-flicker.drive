// A thread opened, closed and opened again inside one slide in, the chat
// scrolled up beside it: the chat does not move, and its column narrows
// once, when the last slide in has ended (not on an earlier one's end).
// check: flicker hold=chat narrows=0.3
{"width": 1180}
{"select": "{{chat}}"}
{"wait": 2}
{"scroll": 900}
{"wait": 1}
{"probe": "flicker", "for": 3}
// Open, close and open again 60 ms apart: both inside the first slide
// in (SidePanelSplit.slideIn, 0.2 s), whose end must not narrow the column.
{"thread": "visible", "next": 0.06}
{"close": "thread", "next": 0.06}
{"thread": "visible"}
{"wait": 2.5}
