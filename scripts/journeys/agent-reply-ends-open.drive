// A tool row opened in a reply still streaming stays open once the reply
// is saved: the same row, its top where it was, still taller.
// check: open keep=1@agent opens=yes
{"width": 1180}
{"agent": "script"}
{"agent": "seed", "turns": 14}
{"select": "Peel"}
{"wait": 1.5}
{"agent": "ask", "tool": true, "words": 30, "rate": 200, "hold": 3}
{"wait": 1}
{"probe": "open", "for": 4}
{"agent": "expand"}
{"wait": 0.5}
{"agent": "done"}
{"wait": 1.5}
