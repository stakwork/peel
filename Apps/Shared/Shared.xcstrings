        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dio un desafío para %2$@, así que Peel no lo firmó."
          }
        }
      }
    },
    "%@ is asking to join for an org you didn't pick: someone else linked this tribe. Approving it sends what's said here to that org." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is asking to join for an org you didn't pick: someone else linked this tribe. Approving it sends what's said here to that org."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pide unirse en nombre de una organización que no elegiste: alguien más vinculó esta tribu. Aprobarlo envía lo que se dice aquí a esa organización."
          }
        }
      }
    },
    "%@ is built and waits for you to make it live; everyone opens %@" : {
