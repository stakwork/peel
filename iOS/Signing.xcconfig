// Signing for the iPhone app. No team is named here: a simulator build needs
// none. To run on a phone, copy Local.xcconfig.example to Local.xcconfig
// (git ignores it) and set your team there.
//
// A bundle ID belongs to one team, as on the Mac (AGENTS.md, Signing):
// dev.peel.ios is Peel's own team's; any other team uses dev.peel.ios.<team>.

PEEL_BUNDLE_ID = dev.peel.ios
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(PEEL_BUNDLE_ID)
