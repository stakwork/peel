        }
      }
    },
    "%@ gave a challenge for %@, so Peel didn't sign it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gave a challenge for %2$@, so Peel didn't sign it."
