    "%@ didn't take the link: it ran out or was already used. Choose Link Peel in Connect there again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ didn't take the link: it ran out or was already used. Choose Link Peel in Connect there again."
