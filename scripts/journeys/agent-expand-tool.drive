// Open a tool row at the bottom of the agent chat: the row keeps its top
// where it was and its details open below it, rather than the bottom
// holding and pushing the row up (T26).
// check: expand keep=1@agent opens=yes
{"width": 1180}
{"agent": "script"}
{"agent": "seed", "turns": 14}
{"agent": "ask", "tool": true, "words": 30, "rate": 400}
{"agent": "done"}
{"select": "Peel"}
{"wait": 1.5}
{"probe": "expand", "for": 2}
{"agent": "expand"}
{"wait": 1.5}
