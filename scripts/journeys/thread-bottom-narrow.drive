// Open and close a thread at the bottom, on a detail column under 681 pt,
// where the thread takes the chat's place. The bottom stays flush (review
// table row 5; rule 8: a list's identity outlives panels and widths).
// check: thread hold=chat
{"width": 760}
{"select": "{{chat}}"}
{"wait": 2}
{"probe": "thread", "for": 3.5}
{"thread": "newest"}
{"wait": 1}
{"close": "thread"}
{"wait": 1.5}
