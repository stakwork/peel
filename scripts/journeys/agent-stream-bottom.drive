// A reply streaming while the agent chat is at its bottom: it follows,
// flush every frame, with no steps (decided 3; rule 2: a row growing while
// following holds the newest, in the same pass).
// check: stream hold=agent
{"width": 1180}
{"agent": "script"}
{"agent": "seed", "turns": 14}
{"select": "Peel"}
{"wait": 1.5}
{"probe": "stream", "for": 9}
{"agent": "ask", "words": 300, "rate": 40}
{"agent": "done"}
{"wait": 0.5}
